# Capture the configured dependency graph instead of maintaining a library list.
function(rdkit_package_targets directory)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    if(target MATCHES "^(Catch2|Catch2WithMain|rdkitCatch)$")
      continue()
    endif()
    get_target_property(type "${target}" TYPE)
    if(NOT type MATCHES "^(STATIC|SHARED)_LIBRARY$")
      continue()
    endif()
    get_target_property(links "${target}" LINK_LIBRARIES)
    set(dependencies "")
    foreach(link IN LISTS links)
      if(TARGET "${link}")
        get_target_property(imported "${link}" IMPORTED)
        if(NOT imported)
          get_target_property(alias "${link}" ALIASED_TARGET)
          if(alias)
            list(APPEND dependencies "\"${alias}\"")
          else()
            list(APPEND dependencies "\"${link}\"")
          endif()
        endif()
      endif()
    endforeach()
    list(REMOVE_DUPLICATES dependencies)
    list(JOIN dependencies "," dependencies_json)
    set_property(GLOBAL APPEND PROPERTY RDKIT_PACKAGE_METADATA
      "\"${target}\":{\"library\":\"$<TARGET_LINKER_FILE_BASE_NAME:${target}>\",\"requires\":[${dependencies_json}]}")
  endforeach()
  get_property(subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(subdirectory IN LISTS subdirectories)
    rdkit_package_targets("${subdirectory}")
  endforeach()
endfunction()

# Public definitions affect class layouts in consumer headers, including the
# mutex members of the thread-safe molecule suppliers.
get_target_property(definitions rdkit_base INTERFACE_COMPILE_DEFINITIONS)
set(public_definitions "")
foreach(definition IN LISTS definitions)
  string(REGEX REPLACE "^-D" "" definition "${definition}")
  if(definition MATCHES "^[A-Za-z_][A-Za-z0-9_]*(=.*)?$")
    string(REPLACE "\\" "\\\\" definition "${definition}")
    string(REPLACE "\"" "\\\"" definition "${definition}")
    list(APPEND public_definitions "\"${definition}\"")
  endif()
endforeach()
list(REMOVE_DUPLICATES public_definitions)
list(JOIN public_definitions "," definitions_json)
set_property(GLOBAL APPEND PROPERTY RDKIT_PACKAGE_METADATA
  "\"rdkit_base\":{\"library\":\"\",\"requires\":[],\"defines\":[${definitions_json}]}")

rdkit_package_targets("${CMAKE_SOURCE_DIR}")
get_property(metadata GLOBAL PROPERTY RDKIT_PACKAGE_METADATA)
list(JOIN metadata ",\n" metadata_json)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/rdkit-components.json"
     CONTENT "{${metadata_json}}\n")
